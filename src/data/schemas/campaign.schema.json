{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "campaign",
 "type": "object",
 "additionalProperties": false,
 "required": ["tuning", "districts", "modifiers", "difficulty", "slots", "raid", "names", "specialties"],
 "definitions": {
  "numTree": { "type": "object", "additionalProperties": { "anyOf": [{ "type": "number" }, { "$ref": "#/definitions/numTree" }] } },
  "pt": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } } },
  "dir": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer", "minimum": -1, "maximum": 1 }, "y": { "type": "integer", "minimum": -1, "maximum": 1 } }, "not": { "properties": { "x": { "const": 0 }, "y": { "const": 0 } } } },
  "slot": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 }, "facing": { "$ref": "#/definitions/dir" } } },
  "extra": { "type": "object", "additionalProperties": false, "required": ["group", "type"], "properties": { "group": { "type": "string" }, "type": { "type": "string" }, "loadout": { "type": "string" } } },
  "swap": { "type": "object", "additionalProperties": false, "required": ["group", "index", "type"], "properties": { "group": { "type": "string" }, "index": { "type": "integer", "minimum": 0 }, "type": { "type": "string" }, "loadout": { "type": "string" } } },
  "change": {
   "type": "object",
   "additionalProperties": false,
   "required": ["text"],
   "properties": {
    "label": { "type": "string" },
    "text": { "type": "string" },
    "tuning": { "$ref": "#/definitions/numTree" },
    "extra": { "type": "array", "items": { "$ref": "#/definitions/extra" } },
    "swap": { "type": "array", "items": { "$ref": "#/definitions/swap" } },
    "aware": { "type": "array", "items": { "type": "string" } },
    "civilians": { "type": "integer", "minimum": 0 },
    "lampsOut": { "type": "integer", "minimum": 0 }
   }
  }
 },
 "properties": {
  "tuning": { "$ref": "#/definitions/numTree" },
  "districts": {
   "type": "array",
   "minItems": 6,
   "maxItems": 6,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "patron", "modifier"],
    "properties": {
     "id": { "enum": ["docks", "foundry", "spire", "market", "stacks", "undercity"] },
     "name": { "type": "string" },
     "patron": { "type": "string" },
     "modifier": { "type": "string" }
    }
   }
  },
  "modifiers": { "type": "object", "additionalProperties": { "allOf": [{ "$ref": "#/definitions/change" }, { "required": ["label"] }] } },
  "difficulty": {
   "type": "object",
   "additionalProperties": false,
   "required": ["1", "2", "3", "4", "5"],
   "properties": { "1": { "$ref": "#/definitions/change" }, "2": { "$ref": "#/definitions/change" }, "3": { "$ref": "#/definitions/change" }, "4": { "$ref": "#/definitions/change" }, "5": { "$ref": "#/definitions/change" } }
  },
  "slots": { "type": "object", "required": ["civilians"], "additionalProperties": { "type": "array", "items": { "$ref": "#/definitions/slot" } } },
  "raid": {
   "type": "object",
   "additionalProperties": false,
   "required": ["guard", "caches"],
   "properties": { "guard": { "type": "string" }, "caches": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/pt" } } }
  },
  "names": { "type": "array", "minItems": 10, "items": { "type": "string" } },
  "specialties": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "string" } }
 }
}
