{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "map",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "width", "height", "legend", "rows", "lamps", "extraction", "squadStart", "bulwarkFacing", "spawnPoints", "waves", "groups", "civilians"],
  "definitions": {
    "pt": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } } },
    "unitDef": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": { "type": { "type": "string" }, "loadout": { "type": "string" }, "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
    }
  },
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "width": { "type": "integer", "minimum": 4 },
    "height": { "type": "integer", "minimum": 4 },
    "legend": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["kind"],
        "properties": { "kind": { "enum": ["floor", "wall", "door", "exit", "escape"] }, "object": { "enum": ["halfCover", "fullCover", "rubble"] } }
      }
    },
    "rows": { "type": "array", "items": { "type": "string" } },
    "lamps": { "type": "array", "items": { "$ref": "#/definitions/pt" } },
    "extraction": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "w": { "type": "integer", "minimum": 1 }, "h": { "type": "integer", "minimum": 1 } } } },
    "squadStart": { "type": "array", "items": { "$ref": "#/definitions/pt" }, "minItems": 6 },
    "bulwarkFacing": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "integer", "minimum": -1, "maximum": 1 }, "y": { "type": "integer", "minimum": -1, "maximum": 1 } } },
    "spawnPoints": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "x", "y"], "properties": { "id": { "type": "string" }, "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } } } },
    "waves": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "type": "string" }, "loadout": { "type": "string" } } } } },
    "groups": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "aware", "units"], "properties": { "id": { "type": "string" }, "aware": { "type": "boolean" }, "units": { "type": "array", "items": { "$ref": "#/definitions/unitDef", "required": ["type", "x", "y"] } } } } },
    "civilians": { "type": "array", "items": { "$ref": "#/definitions/pt" } }
  }
}
